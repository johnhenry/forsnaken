{
  "name": "forsnaken",
  "version": "1.0.0",
  "private": true,
  "description": "A snake game built from HTML elements, on domkit.",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs && playwright test",
    "manifest": "cem analyze && node scripts/manifest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@custom-elements-manifest/analyzer": "^0.11.0"
  },
  "license": "ISC",
  "customElements": "custom-elements.json",
  "exports": {
    ".": "./game/index.mjs",
    "./global": "./game/global.mjs",
    "./custom-elements.json": "./custom-elements.json",
    "./*": "./*"
  }
}
